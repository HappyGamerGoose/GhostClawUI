<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GhostClawUI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GhostClawUI">
    <Grid x:Name="RootHost">
        <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="_sidebarColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="_sidebarBorder" Width="306" Padding="18,18,18,18" BorderThickness="0,0,1,0" Grid.Column="0">
                <Grid>
                    <!-- Expanded Sidebar -->
                    <Grid x:Name="_expandedSidebar">
                        <StackPanel Spacing="16">
                            <!-- Brand Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12" Grid.Column="0">
                                    <Border Width="38" Height="38">
                                        <Image Source="ms-appx:///Assets/GhostClawUI.Icon.png" Width="38" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="_brandName" Text="GhostClaw" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="_statusText" Text="Service unknown" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                                <Button x:Name="_collapseButton" Width="32" Height="32" MinWidth="32" MinHeight="32" CornerRadius="8" BorderThickness="0" Background="Transparent" Grid.Column="1" AutomationProperties.Name="Collapse sidebar">
                                    <FontIcon x:Name="_collapseIcon" Glyph="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Placeholder for Primary Button (New Chat) -->
                            <StackPanel x:Name="_newChatHost" />

                            <TextBlock x:Name="_workspaceLabel" Text="Workspace" FontSize="12" FontWeight="SemiBold" Margin="4,14,0,0" />
                            <StackPanel x:Name="_navStack" Spacing="4" />

                            <StackPanel Spacing="10">
                                <StackPanel x:Name="_searchHost" />
                                <TextBlock x:Name="_chatsLabel" Text="Chats" FontSize="12" FontWeight="SemiBold" Margin="4,14,0,0" />
                                <ListView x:Name="_conversationList" MinHeight="240" BorderThickness="0" Background="Transparent" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Collapsed Sidebar -->
                    <Grid x:Name="_collapsedSidebar" Visibility="Collapsed">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Border x:Name="_brandBtn" Width="40" Height="40" CornerRadius="8" Background="Transparent" Margin="0,0,0,8" ToolTipService.ToolTip="New chat">
                                <Image Source="ms-appx:///Assets/GhostClawUI.Icon.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="_collapsedNavStack" Spacing="12">
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="_noticeHost" Margin="20,18,20,0" Grid.Row="0" />
                <ContentControl x:Name="_content" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Grid.Row="1" />
            </Grid>
        </Grid>
    </Grid>
</Window>
